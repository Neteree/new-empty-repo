---
// A drawn flower head, optionally on a stem with two leaves.
import { petalPath, rings } from '../lib/bloom';

interface Props {
  petals: number;
  petal: string;
  centre: string;
  stem?: boolean;
  label?: string;
  class?: string;
}

const { petals, petal, centre, stem = false, label, class: className } = Astro.props;
const { outer, inner, width } = rings(petals);
const viewBox = stem ? '-60 -60 120 210' : '-60 -60 120 120';
---

<svg
  class:list={['bloom', className]}
  viewBox={viewBox}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {stem && (
    <g class="stem">
      <path d="M0 0 C 4 50 -6 100 2 148" fill="none" stroke-width="3.5" stroke-linecap="round" />
      <path d="M1 92 C 22 78 38 82 44 70 C 30 66 12 72 1 92 Z" class="leaf" />
      <path d="M-1 118 C -22 104 -38 108 -44 96 C -30 92 -12 98 -1 118 Z" class="leaf" />
    </g>
  )}
  {outer.map((angle) => <path d={petalPath(width)} fill={petal} transform={`rotate(${angle})`} />)}
  {inner.map((angle) => <path d={petalPath(width * 0.7, 32)} fill={petal} transform={`rotate(${angle})`} class="inner" />)}
  <circle r={petals > 8 ? 10 : 8} fill={centre} />
</svg>

<style>
  .bloom {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    overflow: visible;
  }
  path {
    opacity: 0.94;
  }
  .inner {
    filter: brightness(0.88);
  }
  .stem path {
    stroke: var(--leaf);
    fill: var(--leaf);
  }
  .stem path:first-child {
    fill: none;
  }
</style>
