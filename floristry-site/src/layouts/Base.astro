---
interface Props {
  title: string;
  description: string;
  /** Relative path back to the site root, e.g. "" or "../". */
  root?: string;
}

const { title, description, root = '' } = Astro.props;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,100;1,9..144,300..600,100&family=Figtree:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <div class="page">
      <header class="masthead">
        <a class="wordmark" href={`${root}index.html`}>
          <svg viewBox="0 0 24 32" aria-hidden="true">
            <path d="M12 31 C 12 20 11 12 12 4" fill="none" stroke-width="1.6" stroke-linecap="round" />
            <path d="M12 18 C 4 16 2 10 3 7 C 9 8 12 12 12 18 Z" />
            <path d="M12 12 C 19 11 22 6 21 3 C 15 4 12 7 12 12 Z" />
          </svg>
          Stem &amp; Loam
        </a>
        <nav aria-label="Main">
          <a href={`${root}index.html#this-week`}>This week</a>
          <a href={`${root}index.html#seasons`}>Seasons</a>
          <a href={`${root}index.html#journal`}>Journal</a>
          <a href={`${root}index.html#visit`}>Visit</a>
        </nav>
      </header>
      <slot />
      <footer class="footer">
        <p class="sign">With love from the flower bench,<br /><span>Stem &amp; Loam</span></p>
        <p class="demo">This is a demo shop. Prices, hours and contact details are made up.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f8f0ed;
    --paper-raised: #fdf8f6;
    --blush: #f1dcd8;
    --ink: #2a332c;
    --ink-soft: #6e6560;
    --leaf: #5f7d56;
    --peony: #a8446c;
    --kraft: #d9c2a5;
    --kraft-shade: #c8ad8c;
    --rule: #e6d3cd;
    --display: 'Fraunces', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    --body: 'Figtree', 'Segoe UI', system-ui, sans-serif;
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --paper: #172019;
      --paper-raised: #1e2a21;
      --blush: #2e2629;
      --ink: #f2e9e5;
      --ink-soft: #bcafa9;
      --leaf: #9fbd92;
      --peony: #ec98b9;
      --kraft: #8c7760;
      --kraft-shade: #756350;
      --rule: #34403a;
      color-scheme: dark;
    }
  }

  :root[data-theme='dark'] {
    --paper: #172019;
    --paper-raised: #1e2a21;
    --blush: #2e2629;
    --ink: #f2e9e5;
    --ink-soft: #bcafa9;
    --leaf: #9fbd92;
    --peony: #ec98b9;
    --kraft: #8c7760;
    --kraft-shade: #756350;
    --rule: #34403a;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  .page {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    padding-block: 0 2.5rem;
  }

  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 400;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.12;
    text-wrap: balance;
    margin: 0;
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 2px solid var(--peony);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Small italic lead-in above headings, in place of shouty uppercase labels. */
  .kicker {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--peony);
    margin: 0;
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--display);
    font-style: italic;
    font-size: 1.7rem;
    text-decoration: none;
  }

  .wordmark svg {
    width: 1.3rem;
    height: auto;
  }

  .wordmark path {
    fill: var(--leaf);
    stroke: var(--leaf);
  }

  .masthead nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.6rem;
  }

  .masthead nav a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .masthead nav a:hover {
    color: var(--peony);
  }

  .footer {
    margin-top: 5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
  }

  .sign {
    margin: 0;
    font-family: var(--display);
    font-style: italic;
    color: var(--ink-soft);
  }

  .sign span {
    font-size: 1.6rem;
    color: var(--ink);
  }

  .demo {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
