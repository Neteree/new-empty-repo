---
// The home page shell: gathers the site's data and optimised photos, then
// hands them to the Svelte sections, which hold all the markup. Interactive
// pieces (the enquiry form, module islands) are placed here, since only an
// .astro file can decide when they load.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.svelte';
import Hero from '../components/Hero.svelte';
import Gallery from '../components/Gallery.svelte';
import Journal from '../components/Journal.svelte';
import Visit from '../components/Visit.svelte';
import { picture } from '../lib/images';
import { mapLink, phoneLink, phoneText } from '../lib/contact';
import { site } from '../site.config';
import { sectionOrder } from '../lib/sections';
import { themes } from '../themes';

// Add-on modules (menu and pre-order, price list…) each add a section
// with a Section.astro in src/modules/<name>/. The order of the sections
// comes from site.json "sections" (see lib/sections.ts).
const modules = Object.fromEntries(
  Object.entries(import.meta.glob<{ default: any }>('../modules/*/Section.astro', { eager: true })).map(([path, mod]) => [path.split('/')[2], mod.default]),
);
const order = sectionOrder(site.sections, Object.keys(modules));

// Skip the collection while there are no posts, so the build doesn't warn.
const hasPosts = Object.keys(import.meta.glob('../content/journal/**/*.md')).length > 0;
const posts = (hasPosts ? await getCollection('journal') : [])
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((post) => ({
    href: `journal/${post.id}.html`,
    date: post.data.date.toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', timeZone: 'Pacific/Auckland' }),
    title: post.data.title,
    excerpt: post.data.excerpt,
  }));

// The look decides how the top of the page is laid out; a wide layout needs a wider photo.
const heroLayout = (themes[site.theme] ?? themes.bold).hero ?? 'split';
const wideHero = heroLayout === 'cover' || heroLayout === 'stacked';
const heroImage = site.heroPhoto
  ? await picture(site.heroPhoto.file, site.heroPhoto.alt, wideHero ? [800, 1200, 1800] : [480, 800, 1200], wideHero ? '100vw' : '(max-width: 52rem) 100vw, 40vw', 'eager')
  : null;
// The slider shows one photo across the page, with small thumbnails to pick from.
const slider = site.galleryLayout === 'slider';
const galleryImages = await Promise.all(
  (site.galleryLayout === 'hidden' ? [] : site.gallery).map((item) => (slider ? picture(item.file, item.alt, [800, 1200, 1800], '100vw') : picture(item.file, item.alt, [400, 800], '(max-width: 40rem) 100vw, 33vw'))),
);
const galleryThumbs = slider ? await Promise.all(site.gallery.map((item) => picture(item.file, '', [160], '4rem'))) : [];
---

<Base title={site.name} description={site.description}>
  <main>
    <Hero
      name={site.name}
      note={`${site.suburb}, ${site.city}${site.heroNote && ` · ${site.heroNote}`}`}
      title={site.heroTitle}
      text={site.heroText}
      button={site.heroLink?.label ? site.heroLink : { label: site.enquiry.title, href: '#enquire' }}
      image={heroImage}
      layout={heroLayout}
    />

    {order.map((id) => {
      if (id === 'gallery') return site.galleryLayout === 'hidden' ? null : <Gallery images={galleryImages} layout={site.galleryLayout} thumbImages={galleryThumbs} />;
      if (id === 'news') return <Journal name={site.name} {posts} />;
      if (id === 'enquire')
        return (
          <section id="enquire" class="section enquire">
            <Visit
              enquiry={site.enquiry}
              visitText={site.visitText}
              phone={phoneLink ? { href: phoneLink, text: phoneText } : null}
              map={mapLink}
              hours={site.hours}
            />
            <div class="form-card">
              {site.enquiry.link?.href ? (
                <a class="button" href={site.enquiry.link.href}>{site.enquiry.link.label}</a>
              ) : (
                <EnquiryForm client:visible />
              )}
            </div>
          </section>
        );
      const Section = modules[id];
      return <Section />;
    })}
  </main>
</Base>

<style>
  .enquire {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 2rem 3rem;
    align-items: start;
  }

  .form-card {
    border: var(--frame);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--lift-l-accent);
  }

  @media (max-width: 52rem) {
    .enquire {
      grid-template-columns: 1fr;
    }
  }
</style>
