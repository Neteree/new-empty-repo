---
// Menu and pre-order section, added to the home page by the starter.
import PreOrder from './PreOrder.svelte';
import { demoMenu, section } from './menu';
import { site } from '../../site.config';
---

<section id="order" class="section">
  <div class="section-head">
    <p class="hand-note">{section.note}</p>
    <h2>{section.title}</h2>
    <p class="intro">{section.intro}</p>
  </div>
  {demoMenu && !site.demo && <p class="intro">[PLACEHOLDER: the client's real menu goes in src/modules/food/menu.json]</p>}
  <PreOrder client:load />
</section>
