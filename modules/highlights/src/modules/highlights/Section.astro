---
// Highlights section shell, added to the home page by the starter. No JavaScript.
import SectionHead from '../../components/SectionHead.svelte';
import Highlights from './Highlights.svelte';
import { highlights } from './highlights';
---

{highlights.items.length > 0 && (
  <section id="highlights" class="section" aria-labelledby="highlights-title">
    <SectionHead id="highlights-title" note={highlights.section.note} title={highlights.section.title} hiddenTitle="Why choose us" />
    <Highlights items={highlights.items} />
  </section>
)}
