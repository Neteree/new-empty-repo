---
// FAQ section shell, added to the home page by the starter. No JavaScript.
import SectionHead from '../../components/SectionHead.svelte';
import Questions from './Questions.svelte';
import { faq } from './faq';
---

{faq.questions.length > 0 && (
  <section id="faq" class="section">
    <SectionHead note={faq.section.note} title={faq.section.title} />
    <Questions questions={faq.questions} />
  </section>
)}
