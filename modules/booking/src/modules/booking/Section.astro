---
// Booking or quote section shell, added to the home page by the starter. The
// form is an island, like the enquiry form.
import SectionHead from '../../components/SectionHead.svelte';
import BookingForm from './BookingForm.svelte';
import { booking } from './booking';
---

<section id="book" class="section">
  <SectionHead note={booking.section.note} title={booking.section.title} intro={booking.section.intro} />
  <div class="form-card">
    <BookingForm client:visible settings={booking} />
  </div>
</section>

<style>
  .form-card {
    max-width: 44rem;
    border: var(--frame);
    border-radius: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--lift-l-accent);
  }
</style>
