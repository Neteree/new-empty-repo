---
// Bouquet section shell, added to the home page by the starter. The 3D part
// is an island that only loads when someone scrolls to it.
import SectionHead from '../../components/SectionHead.svelte';
import Bouquet from './Bouquet.svelte';
import { bouquet } from './bouquet';
---

<section id="bouquet" class="section">
  <SectionHead note={bouquet.section.note} title={bouquet.section.title} intro={bouquet.section.intro} />
  <Bouquet client:visible count={bouquet.flowers} colours={bouquet.colours} />
  <p class="play"><a href="game.html">Play the flower game: {bouquet.game.title}</a></p>
</section>

<style>
  .play {
    margin: 1.5rem 0 0;
    font-weight: 700;
  }
  .play a {
    color: var(--accent);
  }
</style>
