---
// The flower game page (from the bouquet module). Its own page, so three.js
// only loads here and on the bouquet section, never on the rest of the site.
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.svelte';
import Game from '../modules/bouquet/Game.svelte';
import { bouquet } from '../modules/bouquet/bouquet';
import { site } from '../site.config';
---

<Base title={`${bouquet.game.title} · ${site.name}`} description={`A little flower game from ${site.name}.`}>
  <main class="section">
    <SectionHead level={1} note="Just for fun" title={bouquet.game.title} intro={bouquet.game.intro} />
    <Game client:load game={bouquet.game} />
  </main>
</Base>

<style>
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    margin-top: 0.3rem;
  }
</style>
